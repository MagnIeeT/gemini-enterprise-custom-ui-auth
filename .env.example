# ==============================================================================
# Gemini Enterprise Custom UI Authentication (.env.example)
# Copy this file to .env and fill in your Google Cloud & Gemini Enterprise values:
#   cp .env.example .env
# ==============================================================================

# 1. Core Google Cloud Project
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=123456789012

# Default query for testing :streamAssist
QUERY="What are our standard SLA escalation policies?"

# ------------------------------------------------------------------------------
# Part 1A: Pure Google Identity (Google Workspace / Cloud Identity)
# ------------------------------------------------------------------------------
GE_GOOGLE_ID_ENGINE_ID=your-google-identity-ge-engine-id
GE_GOOGLE_ID_LOCATION=global
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# Part 1B: Pure Workforce Identity Federation (Okta / Entra ID / Ping -> Google STS)
# ------------------------------------------------------------------------------
WIF_POOL_ID=your-workforce-pool-id
WIF_PROVIDER_ID=your-oidc-provider-id
GE_WIF_ENGINE_ID=your-wif-ge-engine-id
GE_WIF_LOCATION=us
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-entra-client-id

# ------------------------------------------------------------------------------
# Part 1C: Direct Workload Identity Federation (Entra ID -> Google STS -> :streamAssist)
# ------------------------------------------------------------------------------
WORKLOAD_POOL_ID=your-workload-identity-pool-id
WORKLOAD_PROVIDER_ID=your-workload-oidc-provider-id
WORKLOAD_ENTRA_CLIENT_ID=your-workload-entra-client-id
WORKLOAD_ENTRA_CLIENT_SECRET=your-workload-entra-client-secret

# ------------------------------------------------------------------------------
# Part 2: Federated Connector 3LO (acquireAccessToken & acquireAndStoreRefreshToken)
# ------------------------------------------------------------------------------
CONNECTOR_COLLECTION_ID=your-federated-connector-collection-id
CONNECTOR_LOCATION=global
CONNECTOR_REDIRECT_URI=https://vertexaisearch.cloud.google.com/oauth-redirect

# ------------------------------------------------------------------------------
# Part 3: Custom High-Code ADK Agent Registered in Gemini Enterprise
# (OAuth Client IDs & Secrets live in GCP Auth Manager `authProviders`, not .env)
# ------------------------------------------------------------------------------
GE_GOOGLE_ID_AGENT_ID=your-google-identity-registered-agent-id
GE_WIF_AGENT_ID=your-wif-registered-agent-id
AUTH_PROVIDER_LOCATION=us-central1
GOOGLE_AUTH_PROVIDER_ID=google-workspace-provider
SHAREPOINT_AUTH_PROVIDER_ID=sharepoint-provider

